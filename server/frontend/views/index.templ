package views

templ Index(withAccessToken bool, scope, clientID string) {
	@Layout() {
		<main class="flex flex-col gap-4">
			if !withAccessToken {
				<h1 class="self-center font-bold">안녕하세요.</h1>
				<form
					hx-post="/login"
					hx-swap="outerHTML"
					class="self-center bg-white flex flex-col"
				>
					<label for="password-input">Escribe la contraseña maestra.</label>
					<input
						type="password"
						name="password"
						id="password-input"
						class="border"
					/>
					<button type="submit">Enviar</button>
				</form>
			} else {
				<h1 class="self-center font-bold text-xl">SL</h1>
				<button
					hx-get="/lesson/add"
					hx-swap="afterend"
					hx-trigger="click[!document.getElementById('add-lesson-form')]"
					class="bg-blue-400 w-fit rounded-xs self-center px-4 py-2"
				>Añadir lección</button>
			}
		</main>
	}
}
